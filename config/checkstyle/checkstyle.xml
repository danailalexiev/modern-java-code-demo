<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Crude, stage-safe guardrail: ban "default ->" in api/service/domain, where our
  switches over sealed types live. Error Prone's NoDefaultOnSealedSwitch (in
  :checks) is the precise version: this one is deterministic and has false
  positives (it can't tell a sealed switch from any other), but it's a two
  minute setup and needs no compiler internals.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <module name="TreeWalker">
        <module name="RegexpSinglelineJava">
            <property name="id" value="NoDefaultArrowOnSealedSwitch"/>
            <property name="format" value="default\s*-&gt;"/>
            <property name="message"
                value="No default branch on a switch over a sealed type. Handle every case explicitly."/>
        </module>
    </module>
</module>
